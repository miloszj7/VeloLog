# Django's secret key. No default — required. Generate a unique value per environment
# (never reuse the CI-only placeholder in deploy.yml, which is not a real secret).
SECRET_KEY=

# Defaults to False (matches production and CI) if unset or left blank here. Copying this
# file to .env verbatim keeps DEBUG=False, which turns on the HTTPS redirect
# (SECURE_SSL_REDIRECT) in velo_log/settings.py and returns 301 for every plain-HTTP
# request — including from the Django test client. The suite is safe under DEBUG=False
# only because tests/conftest.py's autouse fixture neutralizes SECURE_SSL_REDIRECT;
# runserver is not, so set DEBUG=True for local development.
DEBUG=False

# Comma-separated hostnames Django will serve. Defaults to an empty list. Required
# (non-empty) whenever DEBUG=False, since Django rejects any Host header not in this list.
ALLOWED_HOSTS=

# Path to the SQLite database file. Defaults to db.sqlite3 in the project root if unset.
DB_PATH=
