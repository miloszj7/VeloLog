# Django's secret key. No default — required. Generate a unique value per environment
# (never reuse the CI-only placeholder in deploy.yml, which is not a real secret).
SECRET_KEY=

# Defaults to False (matches production and CI) if unset or left blank here. Copying this
# file to .env verbatim keeps DEBUG=False, which turns on the HTTPS redirect
# (SECURE_SSL_REDIRECT) in velo_log/settings.py and returns 301 for every plain-HTTP
# request — including from the Django test client. The suite is safe under DEBUG=False
# only because tests/conftest.py's autouse fixture neutralizes SECURE_SSL_REDIRECT;
# runserver is not, so set DEBUG=True for local development.
DEBUG=False

# Comma-separated hostnames Django will serve. Defaults to an empty list. Required
# (non-empty) whenever DEBUG=False, since Django rejects any Host header not in this list.
ALLOWED_HOSTS=

# Path to the SQLite database file. Defaults to db.sqlite3 in the project root if unset
# or left blank. Commented out so a verbatim copy of this file starts from that default.
#DB_PATH=

# Absolute path to the directory holding user uploads (GPX files). Defaults to media/ in
# the project root if unset or left blank, which is fine for local development but
# ephemeral inside a container — files written there are lost on the next redeploy.
# Production points this at the mounted Railway Volume; the value lives in the Railway
# environment, not here (see DEPLOY.md). /healthz/ returns 500 when DEBUG=False and this
# path resolves inside the project root, so a missed setting fails loudly instead of
# quietly losing uploads.
#MEDIA_ROOT=

# Sentry DSN for error/performance monitoring. Optional — when unset or blank, Sentry
# is never initialized and no network calls are made (see velo_log/settings.py). Only
# set in the Railway environment; never set locally or in CI.
#
# If you do set it locally to test against a personal Sentry project, unset it again
# before running the test suite. Several tests re-import settings in-process or in a
# subprocess that inherits your environment (tests/test_settings_security.py,
# tests/test_settings_env.py, tests/test_suite_bites.py), so a suite run would fire
# sentry_sdk.init() repeatedly and ship test noise to that project.
#SENTRY_DSN=

# Environment tag attached to every Sentry event. Defaults to "production" if unset or
# left blank. Only meaningful once SENTRY_DSN is also set.
#SENTRY_ENVIRONMENT=

# Release tag attached to every Sentry event — the deploying commit SHA. Set by
# .github/workflows/deploy.yml on every deploy; never set by hand, here or in Railway.
#SENTRY_RELEASE=